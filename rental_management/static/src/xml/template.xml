<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="rental_management.rental_dashboard" owl="1">
        <section class="section tk_rental_dash">
            <div class="container">
                <div class="row">
                    <div class="col-12 mt32">
                        <h4 class="tk-primary">Rent Contract Statics</h4>
                        <hr class="border-primary"/>
                    </div>

                    <!-- <t t-if="canSeeContracts"> -->
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16" t-on-click="() => this.viewPropertyTenancies('new_contract')">
                            <div class="card info-bg p-32">
                                <div class="card-body info-bg tk-card-body">
                                    <img alt="users" width="40" src="/rental_management/static/src/img/contract_d.svg" />
                                    <h4 class="tk-st-1 info-bg"> Draft Contracts </h4>
                                    <h6 class="tk-st-2 info-bg"> <t t-out="this.state.propertyStats['draft_contract']"/> </h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16" t-on-click="() => this.viewPropertyTenancies('close_contract')">
                            <div class="card danger-bg p-32">
                                <div class="card-body danger-bg tk-card-body">
                                    <img alt="users" width="40" src="/rental_management/static/src/img/warning.svg" />
                                    <h4 class="tk-st-1 danger-bg"> Expiring Contracts</h4>
                                    <h6 class="tk-st-2 danger-bg">  <t t-out="this.state.propertyStats['close_contract']"/> </h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16" t-on-click="() => this.viewPropertyTenancies('expire_contract')">
                            <div class="card danger-bg p-32">
                                <div class="card-body danger-bg tk-card-body">
                                    <img alt="users" width="40" src="/rental_management/static/src/img/warning.svg" />
                                    <h4 class="tk-st-1 danger-bg"> Expired Contracts</h4>
                                    <h6 class="tk-st-2 danger-bg">  <t t-out="this.state.propertyStats['expire_contract']"/> </h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16" t-on-click="() => this.viewDocs('pending')">
                            <div class="card danger-bg p-32">
                                <div class="card-body danger-bg tk-card-body">
                                <img
                                    alt="users"
                                    width="40"
                                    src="/rental_management/static/src/img/unapproved-docs.svg"/>
                                    <h4 class="tk-st-1 danger-bg">
                                        Documents - Not Verified
                                    </h4>
                                    <h6 class="tk-st-2 danger-bg">
                                        <t t-out="this.state.propertyStats['unapproved_documents']"/>
                                    </h6>
                                </div>
                            </div>
                        </div>
                    <!-- </t> -->

                    <t t-if="this.state.propertyStats.finance_comment_count > 0">
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16"
                             t-on-click="() => this.viewPayments('with_finance_comments')">
                            <div class="card finance-bg p-32">
                                <div class="card-body finance-bg tk-card-body">
                                    <img alt="finance" width="40"
                                         src="/rental_management/static/src/img/finance.svg"/>
                                    <h4 class="tk-st-1 finance-bg">
                                        Contracts – Finance Comments
                                    </h4>
                                    <h6 class="tk-st-2 finance-bg">
                                        <t t-out="this.state.propertyStats['finance_comment_count']"/>
                                    </h6>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="this.state.propertyStats.leasing_comment_count > 0">
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16"
                             t-on-click="() => this.viewPayments('with_leasing_comments')">
                            <div class="card leasing-bg p-32">
                                <div class="card-body leasing-bg tk-card-body">
                                    <img alt="leasing" width="40"
                                         src="/rental_management/static/src/img/leasing.svg"/>
                                    <h4 class="tk-st-1 leasing-bg">
                                        Contracts – Leasing Comments
                                    </h4>
                                    <h6 class="tk-st-2 leasing-bg">
                                        <t t-out="this.state.propertyStats['leasing_comment_count']"/>
                                    </h6>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="this.state.propertyStats.new_leads > 0">
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16" t-on-click="() => this.viewCRM('new_lead')">
                            <div class="card success-bg p-32">
                                <div class="card-body success-bg tk-card-body">
                                    <img alt="users" width="40" src="/rental_management/static/src/img/running_c.svg" />
                                    <h4 class="tk-st-1 success-bg">Contracts - Unreceived Payments</h4>
                                    <h6 class="tk-st-2 success-bg">   <t t-out="this.state.propertyStats['new_leads']"/> </h6>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                <div class="row">
                    <div class="col-12 mt32">
                        <h4 class="tk-primary">Accounting Information</h4>
                        <hr class="border-primary"/>
                    </div>
                    <!-- Upcoming PDC Deposits -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16"
                        t-on-click="() => this.viewPDC('upcoming_pdc')"
                        style="cursor:pointer;">
                        <div class="card info-bg p-32"
                            style="background:linear-gradient(135deg,#dbeafe,#bfdbfe);color:#1e3a8a;">
                            <div class="card-body tk-card-body" style="background:none;">
                                <img alt="Upcoming PDC" width="40" src="/rental_management/static/src/img/pdc_image.png"/>
                                <h4 class="tk-st-1">Upcoming PDC Deposits</h4>
                                <h6 class="tk-st-2">
                                    <t t-out="this.state.propertyStats['upcoming_pdc']"/>
                                </h6>
                            </div>
                        </div>
                    </div>

                    <!-- Bounced PDC -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16"
                        t-on-click="() => this.viewPDC('bounced')"
                        style="cursor:pointer;">
                        <div class="card danger-bg p-32"
                            style="background:linear-gradient(135deg,#fee2e2,#fecaca);color:#7f1d1d;">
                            <div class="card-body tk-card-body" style="background:none;">
                                <img alt="Bounced PDC" width="40" src="/rental_management/static/src/img/pdc_image.png"/>
                                <h4 class="tk-st-1">Bounced PDC</h4>
                                <h6 class="tk-st-2">
                                    <t t-out="this.state.propertyStats['bounced_pdc']"/>
                                </h6>
                            </div>
                        </div>
                    </div>

                    <!-- Not Received PDC -->
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16"
                        t-on-click="() => this.viewPDC('not_received')"
                        style="cursor:pointer;">
                        <div class="card warning-bg p-32"
                            style="background:linear-gradient(135deg,#fef3c7,#fde68a);color:#78350f;">
                            <div class="card-body warning-bg tk-card-body">
                                <img alt="Not Received PDC" width="40" src="/rental_management/static/src/img/pdc_image.png"/>
                                <h4 class="tk-st-1 warning-bg">PDC Amount Not Received</h4>
                                <h6 class="tk-st-2 warning-bg">
                                    <t t-out="this.state.propertyStats['not_received_pdc']"/>
                                </h6>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2 mb-4 mt8 mb16" t-on-click="() => this.viewPropertyTenancies('not_paid')">
                        <div class="card danger-bg p-32">
                            <div class="card-body danger-bg tk-card-body">
                                <img alt="users" width="40" src="/rental_management/static/src/img/pending.svg" />
                                <h4 class="tk-st-1 danger-bg"> Invoice Due </h4>
                                <h6 class="tk-st-2 danger-bg">  <t t-out="this.state.propertyStats['pending_invoice']"/></h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </t>
</templates>