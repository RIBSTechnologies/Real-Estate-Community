<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--  tree view of hr leave-->
    <record id="hr_leave_view_tree" model="ir.ui.view">
        <field name="name">hr.leave.view.tree.inherit.ent.hrms.dashboard</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">duration_display</attribute>
            </xpath>
        </field>
    </record>
    <record id="hr_leave_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_approve'][1]" position="attributes">
                <attribute name="groups">hr.group_hr_manager</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_approve'][2]" position="attributes">
                <attribute name="groups">hr.group_hr_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_refuse']" position="attributes">
                <attribute name="groups">hr.group_hr_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_back_to_approval']" position="attributes">
                <attribute name="groups">hr.group_hr_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="groups">hr.group_hr_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
