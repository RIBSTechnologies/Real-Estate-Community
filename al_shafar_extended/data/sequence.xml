<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Contract Reference -->
        <record id="seq_contract_contract" model="ir.sequence">
            <field name="name">Contract Sequence</field>
            <field name="code">contract.contract</field>
            <field name="prefix">CNT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Contract Termination Audit Reference -->
        <record id="seq_contract_termination_audit" model="ir.sequence">
            <field name="name">Contract Termination Audit Sequence</field>
            <field name="code">contract.termination.audit</field>
            <field name="prefix">SETTL/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
