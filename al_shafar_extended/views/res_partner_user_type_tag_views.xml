<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_partner_view_form_additional_user_types" model="ir.ui.view">
            <field name="name">res.partner.form.additional.user.types</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='user_type']" position="after">
                    <field name="additional_user_type_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
