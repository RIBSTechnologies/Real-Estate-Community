<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_request_view_form_vendor_bill_total" model="ir.ui.view">
            <field name="name">purchase.request.form.vendor.bill.total</field>
            <field name="model">purchase.request</field>
            <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[hasclass('oe_subtotal_footer')]/field[@name='estimated_cost']" position="after">
                    <div class="oe_subtotal_footer_separator oe_inline">
                        <label for="parts_total_untaxed_amount"/>
                    </div>
                    <field name="parts_total_untaxed_amount" nolabel="1"
                           class="oe_subtotal_footer_separator" widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
