<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="maintenance_assignment_rule_view_list" model="ir.ui.view">
            <field name="name">maintenance.assignment.rule.list</field>
            <field name="model">maintenance.assignment.rule</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="building_id"/>
                    <field name="maintenance_type_id"/>
                    <field name="technician_id"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="maintenance_assignment_rule_action" model="ir.actions.act_window">
            <field name="name">Maintenance Assignment Rules</field>
            <field name="res_model">maintenance.assignment.rule</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="menu_maintenance_assignment_rule"
                  name="Assignment Rules"
                  parent="maintenance.menu_maintenance_configuration"
                  action="maintenance_assignment_rule_action"
                  sequence="20"/>
    </data>
</odoo>
