<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Res Config Settings Inherit View -->
    <record id="res_config_settings_view_form_al_shafar" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.al.shafar.extended</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='accounting_reports']" position="after">
                <block title="Contract Termination Settlement" id="contract_termination_settings">
                    <setting help="Default policy for calculating prepaid refunds upon early contract termination.">
                        <field name="settlement_method" widget="radio"/>
                    </setting>
                </block>
                <block title="Unit Master - Area Conversion" id="unit_master_area_conversion">
                    <setting help="Conversion factor used to automatically compute 'Unit M Size' on every Unit (property.details), based on its Area Measurement Unit (sq.m or sq.ft). Changing this value recalculates Unit M Size on all Units.">
                        <field name="sqm_to_sqft_ratio"/> sq.ft per sq.m
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
