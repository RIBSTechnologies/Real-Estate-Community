<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Quick Theme Switch popup, opened from the navbar icon.        -->
    <!--                                                                -->
    <!-- No widget on the `theme` field on purpose: Selection fields    -->
    <!-- render as a plain native dropdown by default, which is the     -->
    <!-- compact look this popup wants. The full Settings screen        -->
    <!-- (erp_ui_redesign_settings_views.xml) still uses radio buttons   -->
    <!-- for that fuller, admin-only page - this one stays a one-line    -->
    <!-- dropdown + Apply, open to every internal user.                  -->
    <!-- ============================================================ -->

    <record id="view_erp_ui_theme_quickswitch_form" model="ir.ui.view">
        <field name="name">erp.ui.theme.quickswitch.form</field>
        <field name="model">erp.ui.theme.quickswitch</field>
        <field name="arch" type="xml">
            <form string="Choose Theme">
                <group>
                    <field name="theme"/>
                </group>
                <footer>
                    <button string="Apply" type="object" name="action_apply" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_erp_ui_theme_quickswitch" model="ir.actions.act_window">
        <field name="name">Choose Theme</field>
        <field name="res_model">erp.ui.theme.quickswitch</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_erp_ui_theme_quickswitch_form"/>
        <field name="target">new</field>
    </record>

</odoo>
