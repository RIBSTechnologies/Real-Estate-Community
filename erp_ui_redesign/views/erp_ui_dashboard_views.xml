<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- ERP UI Redesign - Document Dashboard                          -->
    <!--                                                                -->
    <!-- ir.actions.client, not act_window: there is no model behind    -->
    <!-- this screen. The `tag` must match the string the OWL component -->
    <!-- registers itself under in the "actions" registry (see          -->
    <!-- static/src/js/erp_ui_dashboard.js, last line) - a mismatch     -->
    <!-- there gives a blank page with an "unknown action" console      -->
    <!-- error and no server-side warning.                              -->
    <!--                                                                -->
    <!-- Loaded AFTER erp_ui_redesign_settings_views.xml in the         -->
    <!-- manifest because the parent menu is defined there.             -->
    <!-- ============================================================ -->

    <record id="action_erp_ui_dashboard" model="ir.actions.client">
        <field name="name">ERP Documents</field>
        <field name="tag">erp_ui_redesign_dashboard</field>
    </record>

    <menuitem id="menu_erp_ui_dashboard"
              name="Documents"
              parent="menu_erp_ui_redesign_root"
              action="action_erp_ui_dashboard"
              sequence="5"/>

</odoo>
