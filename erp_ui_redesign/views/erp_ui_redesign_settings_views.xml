<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- ERP UI Redesign settings.                                     -->
    <!--                                                                -->
    <!-- Runs on its own model (erp.ui.redesign.settings), its own      -->
    <!-- menu, and opens as a small popup dialog (target="new"). It     -->
    <!-- does not touch, inherit, or extend res.config.settings or any  -->
    <!-- core Settings view, so it cannot appear inside the Settings    -->
    <!-- app's tab bar and cannot affect anything under Settings.       -->
    <!-- ============================================================ -->

    <record id="view_erp_ui_redesign_settings_form" model="ir.ui.view">
        <field name="name">erp.ui.redesign.settings.form</field>
        <field name="model">erp.ui.redesign.settings</field>
        <field name="arch" type="xml">
            <form string="ERP UI Redesign Settings">
                <sheet>
                    <div class="oe_title">
                        <h1>Appearance</h1>
                        <p class="text-muted">
                            Applies across every form and list view for all
                            users. Takes effect after a page refresh.
                        </p>
                    </div>
                    <group>
                        <field name="theme" widget="radio" string="Visual Theme"/>
                        <field name="font_family" widget="radio" string="Interface Font"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" type="object" name="action_save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_erp_ui_redesign_settings" model="ir.actions.act_window">
        <field name="name">ERP UI Redesign Settings</field>
        <field name="res_model">erp.ui.redesign.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_erp_ui_redesign_settings_form"/>
        <field name="target">new</field>
    </record>

    <!-- Own top-level menu (an app of its own in the app switcher), fully
         separate from Settings. If you'd rather it sit inside an existing
         "Configuration" menu you already have (e.g. a property management
         module), point a <menuitem> there at
         action="erp_ui_redesign.action_erp_ui_redesign_settings" instead
         and remove the two menuitems below. -->
    <menuitem id="menu_erp_ui_redesign_root"
              name="ERP UI Redesign"
              sequence="950"
              groups="base.group_system"/>

    <menuitem id="menu_erp_ui_redesign_settings"
              name="Appearance Settings"
              parent="menu_erp_ui_redesign_root"
              action="action_erp_ui_redesign_settings"
              sequence="10"
              groups="base.group_system"/>

</odoo>
