<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="theme_liquid_glass.LgSchemeIcon">
        <svg t-if="icon === 'light'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5"/>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg t-elif="icon === 'dark'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
        <svg t-else="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="5" y="2" width="14" height="20" rx="2.5"/>
            <path d="M11 18h2"/>
        </svg>
    </t>

    <t t-name="theme_liquid_glass.ColorSchemeToggle">
        <Dropdown position="'bottom-end'" menuClass="'o_lg_scheme_menu'">
            <button class="o_lg_scheme_toggle" title="Appearance: light / dark" aria-label="Appearance">
                <t t-call="theme_liquid_glass.LgSchemeIcon" icon="this.shownIcon"/>
            </button>
            <t t-set-slot="content">
                <DropdownItem
                    t-foreach="this.options"
                    t-as="opt"
                    t-key="opt.value"
                    class="{ 'o_lg_scheme_item': true, 'o_lg_active': this.mode === opt.value }"
                    onSelected="() => this.scheme.setMode(opt.value)"
                >
                    <t t-call="theme_liquid_glass.LgSchemeIcon" icon="opt.value"/>
                    <span t-out="opt.label"/>
                    <span class="o_lg_scheme_check">&#10003;</span>
                </DropdownItem>
            </t>
        </Dropdown>
    </t>

</templates>
