<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="property_details_inherit_new" model="ir.ui.view">
            <field name="name">property.details.form</field>
            <field name="model">property.details</field>
            <field name="inherit_id" ref="ribs_real_estate.property_details_form_view_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='security_number']" position="after">
                    <field name="analytic_account_id" invisible="1"></field>
                </xpath>
            </field>
        </record>
    </data>

    <data>
         <record id="property_project_view_form_inherit_1" model="ir.ui.view">
            <field name="name">property.project.view.form</field>
            <field name="model">property.project</field>
            <field name="inherit_id" ref="rental_management.property_project_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='property_manager']" position="after">
                    <field name="project_id" required="False" force_save="1"/>
                </xpath>
            </field>
        </record>
    </data>

</odoo>