<odoo>
    <data noupdate="1">
        <record model="res.groups.privilege" id="module_category_hr_payroll">
            <field name="name">Payroll</field>
            <field name="description">Helps you manage your payrolls.</field>
            <field name="sequence">16</field>
        </record>

        <record id="group_hr_payroll_user" model="res.groups">
            <field name="name">Officer</field>
            <field name="privilege_id" ref="module_category_hr_payroll"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <record id="group_hr_payroll_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="module_category_hr_payroll"/>
            <field name="implied_ids" eval="[(4, ref('wk_hr_payroll.group_hr_payroll_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[(4,ref('wk_hr_payroll.group_hr_payroll_manager'))]"/>
        </record> -->


    </data>
</odoo>
