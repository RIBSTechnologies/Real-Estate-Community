<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pdc_unhold_wizard_form" model="ir.ui.view">
        <field name="name">pdc.unhold.wizard.form</field>
        <field name="model">pdc.unhold.wizard</field>
        <field name="arch" type="xml">
            <form string="Unhold PDC">
                <group>
                    <field name="payment_date"/>
                    <field name="due_date"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
