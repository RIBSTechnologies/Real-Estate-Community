<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_bank_list" model="ir.ui.view">
        <field name="name">res.bank.list</field>
        <field name="model">res.bank</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="bic"/>
                <field name="country"/>
            </list>
        </field>
    </record>

    <record id="view_res_bank_form" model="ir.ui.view">
        <field name="name">res.bank.form</field>
        <field name="model">res.bank</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bic"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="zip"/>
                            <field name="state"/>
                            <field name="country"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_bank_form" model="ir.actions.act_window">
        <field name="name">Banks</field>
        <field name="res_model">res.bank</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_res_bank" action="action_res_bank_form"
              parent="account.account_invoicing_menu" sequence="30"/>
</odoo>
