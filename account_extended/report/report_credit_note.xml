<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tax Credit Note - same layout as the UAE Rental Tax Invoice
         (account_extended.report_move_document), shown on customer credit notes. -->
    <template id="report_credit_note">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="show_company_logo" t-value="True"/>
                <t t-set="is_credit_note" t-value="True"/>
                <t t-call="web.external_layout">
                    <t t-call="account_extended.report_move_document"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_credit_note" model="ir.actions.report">
        <field name="name">Credit Note</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_extended.report_credit_note</field>
        <field name="print_report_name">'Credit Note - %s' % (object.name or '').replace('/', '-')</field>
        <field name="domain">[('move_type', '=', 'out_refund')]</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="ribs_real_estate.paperformat_custom_invoice"/>
    </record>

</odoo>
