<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vendor Bill / Vendor Refund - same layout as the UAE Rental Tax
         Invoice (account_extended.report_move_document). -->
    <template id="report_vendor_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="show_company_logo" t-value="True"/>
                <t t-set="doc_kind" t-value="'bill'"/>
                <t t-call="web.external_layout">
                    <t t-call="account_extended.report_move_document"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_vendor_bill" model="ir.actions.report">
        <field name="name">Vendor Bill</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_extended.report_vendor_bill</field>
        <field name="print_report_name">'Vendor Bill - %s' % (object.name or '').replace('/', '-')</field>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="ribs_real_estate.paperformat_custom_invoice"/>
    </record>

    <record id="action_report_vendor_refund" model="ir.actions.report">
        <field name="name">Vendor Refund</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_extended.report_vendor_bill</field>
        <field name="print_report_name">'Vendor Refund - %s' % (object.name or '').replace('/', '-')</field>
        <field name="domain">[('move_type', '=', 'in_refund')]</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="ribs_real_estate.paperformat_custom_invoice"/>
    </record>

</odoo>
