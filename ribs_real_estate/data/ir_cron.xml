        <record id="ir_cron_action_contract_renwal_reminder" model="ir.cron">
            <field name="name">Contract Renwal Reminder</field>
            <field name="model_id" ref="ribs_real_estate.model_tenancy_details"/>
            <field name="state">code</field>
            <field name="code">model.send_contract_renewal_reminder()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall">2025-10-03 18:30:00</field>
        </record>

        <record id="ir_cron_check_priority_requests" model="ir.cron">
            <field name="name">Check Priority Maintenance Requests</field>
            <field name="model_id" ref="ribs_real_estate.model_maintenance_request"/>
            <field name="state">code</field>
            <field name="code">model.check_priority_requests()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_check_expiring_documents" model="ir.cron">
            <field name="name">Check Expiring Documents</field>
            <field name="model_id" ref="ribs_real_estate.model_tenancy_details"/>
            <field name="state">code</field>
            <field name="code">model.check_expiring_documents()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">3</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="rent_recurring_invoice_every_two_months" model="ir.cron">
            <field name="name">Recurring Invoice Every Two Months</field>
            <field name="model_id" ref="rental_management.model_tenancy_details"/>
            <field name="state" eval="'code'"/>
            <field name="code" eval="'model.tenancy_recurring_every_two_months_invoice()'"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="rent_recurring_invoice_every_four_months" model="ir.cron">
            <field name="name">Recurring Invoice Every Four Months </field>
            <field name="model_id" ref="rental_management.model_tenancy_details"/>
            <field name="state" eval="'code'"/>
            <field name="code" eval="'model.tenancy_recurring_every_four_months_invoice()'"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="action_set_project" model="ir.cron">
            <field name="name">Contract - Set Project to Building</field>
            <field name="model_id" ref="ribs_real_estate.model_property_project"/>
            <field name="state" eval="'code'"/>
            <field name="code" eval="'model.action_assign_project()'"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="action_set_analytic_account" model="ir.cron">
            <field name="name">Contract - Set Analytic Account to Unit</field>
            <field name="model_id" ref="ribs_real_estate.model_property_details"/>
            <field name="state" eval="'code'"/>
            <field name="code" eval="'model.action_assign_analytic_account()'"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>