<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ===================== -->
        <!-- B2C DOCUMENTS -->
        <!-- ===================== -->

        <record id="doc_b2c_uae_visa" model="document.document">
            <field name="name">UAE residence visa copy</field>
            <field name="document_for">b2c</field>
        </record>

        <record id="doc_b2c_emirates_id" model="document.document">
            <field name="name">Emirates ID (both sides)</field>
            <field name="document_for">b2c</field>
        </record>

        <record id="doc_b2c_salary_certificate" model="document.document">
            <field name="name">Salary certificate</field>
            <field name="document_for">b2c</field>
        </record>

        <record id="doc_b2c_employment_contract" model="document.document">
            <field name="name">Employment contract</field>
            <field name="document_for">b2c</field>
        </record>

        <record id="doc_b2c_bank_statements" model="document.document">
            <field name="name">Last 3–6 months bank statements</field>
            <field name="document_for">b2c</field>
        </record>

        <record id="doc_b2c_payslips" model="document.document">
            <field name="name">Last 3–6 months payslips</field>
            <field name="document_for">b2c</field>
        </record>

        <record id="doc_b2c_trade_license" model="document.document">
            <field name="name">Trade license</field>
