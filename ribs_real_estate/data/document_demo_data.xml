            <field name="name">No Objection Certificate (NOC) from current landlord</field>
            <field name="document_for">b2c</field>
        </record>

        <record id="doc_b2c_reference_letter" model="document.document">
            <field name="name">Reference letter from previous landlord</field>
            <field name="document_for">b2c</field>
        </record>

        <record id="doc_b2c_photos" model="document.document">
            <field name="name">Passport-sized photos</field>
            <field name="document_for">b2c</field>
        </record>

        <!-- ===================== -->
        <!-- B2B DOCUMENTS -->
        <!-- ===================== -->

        <record id="doc_b2b_trade_license_copy" model="document.document">
            <field name="name">Trade License copy</field>
            <field name="document_for">b2b</field>
        </record>

        <record id="doc_b2b_certificate_incorporation" model="document.document">
            <field name="name">Certificate of Incorporation / Commercial License</field>
            <field name="document_for">b2b</field>
        </record>

        <record id="doc_b2b_moa_aoa" model="document.document">
            <field name="name">Memorandum of Association (MOA) / Articles of Association (AOA)</field>
            <field name="document_for">b2b</field>
        </record>

        <record id="doc_b2b_share_certificate" model="document.document">
            <field name="name">Company Share Certificate (if applicable)</field>
            <field name="document_for">b2b</field>
        </record>

        <record id="doc_b2b_board_resolution" model="document.document">
            <field name="name">Board Resolution authorizing the signatory to sign the tenancy contract</field>
            <field name="document_for">b2b</field>
        </record>

        <record id="doc_b2b_authorized_passport" model="document.document">
            <field name="name">Passport copy of the authorized signatory</field>
            <field name="document_for">b2b</field>
        </record>

        <record id="doc_b2b_authorized_emirates_id" model="document.document">
            <field name="name">Emirates ID copy of the authorized signatory</field>
            <field name="document_for">b2b</field>
        </record>

        <record id="doc_b2b_authorized_visa" model="document.document">
            <field name="name">Valid UAE residence visa copy of the authorized signatory</field>
            <field name="document_for">b2b</field>
        </record>

