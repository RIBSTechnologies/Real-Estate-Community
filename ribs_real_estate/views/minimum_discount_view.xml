<odoo>
    <data>
          <record id="minimum_discount_tree_view" model="ir.ui.view">
            <field name="name">minimum.discount.tree.view</field>
            <field name="model">minimum.discount</field>
            <field name="arch" type="xml">
                <list create="0">
                    <field name="discount" required="1"/>
                </list>
            </field>
        </record>

        <record id="minimum_discount_action" model="ir.actions.act_window">
            <field name="name">Minimum Discount</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">minimum.discount</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>