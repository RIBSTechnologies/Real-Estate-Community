<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="tenancy_details_form_view_inherit" model="ir.ui.view">
            <field name="name">tenancy.details.form.view</field>
            <field name="model">tenancy.details</field>
            <field name="inherit_id" ref="rental_management.tenancy_details_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="create">true</attribute>
                </xpath>
                <xpath expr="//button[@name='action_create_invoice']" position="after">
                    <button name="action_due_reminder" type="object"
                        string="Send Payment Reminder"
                        icon="notifications" icon_class="oi-filled"
                        class="btn btn-danger"
                        invisible="1"/>
<!--                        invisible="invoice_state != 'posted' or payment_state == 'paid'"/>-->
                </xpath>
                <xpath expr="//button[@name='action_maintenance_request']" position="after">
                    <button name="action_tenant_documents" type="object"
                        icon="folder_open" icon_class="oi-filled"
                        class="oe_stat_button">
                        <field name="tenant_document_count" string="Tenant Documents"
                                    widget="statinfo" />
                    </button>
                    <button name="action_contract_details" type="object"
                        icon="folder_open" icon_class="oi-filled"
                        class="oe_stat_button">
                        <field name="document_count" string="Contract Documents"
                                    widget="statinfo" />
                    </button>
                    <button string="Updated Contract Details" name="updated_contract_details" type="object"
                        icon="folder_open" icon_class="oi-filled"
                        class="oe_stat_button"
                        invisible="not new_contract_sent">
                    </button>
                </xpath>
                <xpath expr="//button[@id='extend_contract_button']" position="replace">
                    <button name="renew_contract"
                        type='object'
                        string="✔ Renew Contract"
                        id="extend_contract_button"
                        class="btn btn-outline-success"
                        invisible="not new_contract_sent"/>
                    <button string="Approve" name="closure_first_approval" type="object"
                        class="btn btn-danger" invisible="contract_type != 'closure_pending_approval'"/>
                    <button string="Approve &amp; Terminate" name="closure_final_approval" type="object"
                        class="btn btn-danger" invisible="contract_type != 'closure_final_approval'"/>
                </xpath>
                <xpath expr="//button[@name='action_cancel_contract']" position="after">
                    <button name="send_new_contract" type="object"
                        icon="book"
                        string="Send New Contract Details"
                        invisible="new_contract_sent or contract_type not in ['running_contract','expire_contract']">
                    </button>
                    <!-- <button name="bulk_pdc_upload" type="object"
                        string="Bulk PDC Upload"
                        invisible="new_contract_sent or contract_type != 'running_contract'">
                    </button> -->
                </xpath>
                <xpath expr="//button[@id='contract_payment']" position="before">
                    <button name="request_documents" type="object"
                        class="btn btn-danger"
                        string="Request Documents"
                        invisible="close_contract_state or contract_type in ['waiting','closure_pending_approval','closure_final_approval']">
                    </button>
                    <button name="sent_welcome_pack" type="object"
                        class="btn-info"
                        string="Send Welcome Pack"
                        invisible="close_contract_state or sent_welcome_pack_flag or contract_type != 'running_contract'">
                    </button>
                </xpath>
                <xpath expr="//button[@name='action_close_contract']" position="before">
                    <button name="action_approve_contract"
                            type="object"
                            string="Approve"
                            class="btn btn-success"
                            invisible="contract_type != 'waiting'"/>
                </xpath>
                <xpath expr="//button[@name='action_active_rent_contract']" position="attributes">
                    <attribute name="invisible">contract_type in ['expire_contract','running_contract','waiting','expiring_soon','closure_pending_approval','closure_final_approval'] or close_contract_state</attribute>
                </xpath>
                <xpath expr="//button[@name='action_close_contract']" position="replace">
                    <button name='action_contract_close'
                            type='object'
                            string="Close Contract"
                            class="btn btn-outline-danger"
                            invisible="contract_type in ['new_contract','waiting','closure_pending_approval','closure_final_approval'] or close_contract_state" />
                            <!-- invisible="contract_type in ['new_contract','waiting','closure_pending_approval','closure_final_approval'] or close_contract_state" /> -->
                </xpath>
                <xpath expr="//button[@name='action_create_invoice']" position="attributes">
                    <attribute name="invisible">type == 'automatic' or rent_invoice_id or contract_type == 'Running'</attribute>
                </xpath>
                <xpath expr="//button[@name='action_cancel_contract']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_contract_close']" position="after">
                    <button name='action_clearance_certificate'
                        type='object'
                        string="Issue Clearance Certificate"
                        class="btn btn-outline-danger"
                        invisible="not close_contract_state or issue_clearance_sent" 
                    />
                    <button name='action_clearance_certificate'
                        type='object'
                        string="Re Issue Clearance Certificate"
                        class="btn btn-outline-danger"
                        invisible="not issue_clearance_sent" 
                    />
                </xpath>
                <xpath expr="//page[5]" position="replace">
                </xpath>
                <xpath expr="//group[7]" position="replace">
                </xpath>
                <xpath expr="//field[@name='payment_state']" position="before">
                    <button name="action_upload_pdc"
                        type="object"
                        string="Upload PDC"
                        id="upload_pdc"
                        class="btn btn-info"
                        invisible="1"/>
<!--                        invisible="payment_state == 'paid'"/>-->
                </xpath>
                <xpath expr="//page[1]" position="attributes">
                    <attribute name="groups">ribs_real_estate.property_rental_accountant</attribute>
                </xpath>
                <xpath expr="//page[2]" position="attributes">
                    <attribute name="groups">ribs_real_estate.property_rental_accountant</attribute>
                </xpath>
                <xpath expr="//page[4]" position="attributes">
                    <attribute name="groups">ribs_real_estate.property_rental_accountant</attribute>
                </xpath>
                <xpath expr="//button[@name='action_invoices']" position="attributes">
                    <attribute name="groups">ribs_real_estate.property_rental_accountant</attribute>
                </xpath>
                <xpath expr="//button[@name='action_bills']" position="attributes">
                    <attribute name="groups">ribs_real_estate.property_rental_accountant</attribute>
                </xpath>
                <xpath expr="//button[@id='property_payment_bill']" position="attributes">
                    <attribute name="groups">ribs_real_estate.property_rental_accountant</attribute>
                </xpath>

                <xpath expr="//button[@id='contract_payment']" position="replace">
                </xpath>

                <xpath expr="//page[last()]" position="after">
                    <!-- <page string="Final Inspection Report" invisible="not close_contract_state" >
                        <sheet>
                            <group>
                                <field name="key_card_remote"></field>
                                <field name="parking_card_remote"></field>
                                <field name="damage_or_replacement"></field>
                                <field name="damage_or_replacement_ids" invisible="not damage_or_replacement" force_save="1">
                                    <list editable="bottom">
                                        <field name="caution_type"></field>
                                        <field name="price"></field>
                                        <field name="notes"></field>
                                    </list>
                                </field>
                            </group>
                        </sheet>
                    </page> -->
                    <page string="Clearance Checklist" invisible="not close_contract_state">
                        <sheet>
                            <group>
                                <field name="final_inspection_report"></field>
                                <field name="dewa_certificate_confirmation"></field>
                                <field name="issue_clearance_certificate" invisible="not dewa_certificate_confirmation" widget="many2many_binary"></field>
                            </group>
                        </sheet>
                    </page>
                </xpath>
                <xpath expr="//label[@for='total_rent']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/div" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group/div" position="after">
                    <label for="total_rent_year" string="Rent"/>
                    <div>
                        <field name="total_rent_year" required="1" class="oe_inline" readonly="contract_type != 'new_contract'"/>
                        /
                        Yearly
                    </div>
                    <field name="contract_value"></field>
                </xpath>
                <xpath expr="//field[@name='start_date']" position="after">
                    <label for="grace_period_value" string="Grace Time"/>
                    <div class="o_row">
                        <field name="grace_period_value" nolabel="1" readonly="contract_type != 'new_contract'"/>
                        <field name="grace_period_unit" nolabel="1" readonly="contract_type != 'new_contract'"/>
                    </div>
                    <field name="grace_period_start_date" readonly="1"></field>
                </xpath>
                <xpath expr="//field[@name='end_date']" position="after">
                    <field name="grace_period_end_date" readonly="1"></field>
                </xpath>
                <xpath expr="//field[@name='duration_type']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- <xpath expr="//field[@name='rent_unit']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath> -->
                <!-- <xpath expr="//field[@name='invoice_start_date']" position="after">
                    <field name="responsible_id"></field>
                </xpath> -->
                <xpath expr="//field[@name='start_date']" position="before">
                    <field name="contract_date" readonly="contract_type != 'new_contract'" invisible="1"></field>
                    <field name="temp_seq" invisible="1"></field>
                </xpath>
                <xpath expr="//field[@name='term_condition']" position="after">
                    <label for="additional_term_ids" string="Additional Terms"/>
                    <field name="additional_term_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="description" placeholder="Additional term.."/>
                        </list>
                    </field>
                </xpath>
                <xpath expr="//page[last()]" position="after">
                    <page string="Payment Details">
                        <group>
                            <group>
                                <field name="total_contract_value"/>
                                <field name="remaining_to_pay"/>
                                <button name='contract_payment_pdc'
                                    type="object"
                                    string="Generate Payments"
                                    id="create_payment"
                                    class="btn btn-outline-success"
                                    invisible="contract_type != 'new_contract'" />
                            </group>
                            <group>
                                <field name="total_value_breakdown"/>
                            </group>
                        </group>
                        <field name="contract_payment_ids" readonly="contract_type != 'new_contract'">
                            <list editable="bottom">     
                                <field name="payment_type" required="1"/>
                                <field name="journal_id" required="1"/>
                                <field name="currency_id" column_invisible="1" />
                                <field name="amount" required="1" options="{'currency_field': 'currency_id'}"/>
                                <field name="cheque_num"/>
                                <field name="chq_due_date" required="1"/>
                                <field name="remitter_bank_id"/>
                                <field name="ref"/>
                                <!-- <field name="chq_due_date" 
                                    required="journal_id.type != 'cash'" 
                                    invisible="journal_id.type == 'cash'"/> -->
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </list>
                        </field>
                    </page>
                    <page string="Termination Details" invisible="contract_type not in ['closure_pending_approval','closure_final_approval','terminated','pre_terminated']">
                        <group>
                            <group>
                                <field name="termination_requested_person" readonly="1"/>
                                <field name="first_level_approval_requested_to" widget="many2many_tags" readonly="1"/>
                                <field name="final_level_approval_requested_to" widget="many2many_tags" readonly="1"/>
                                <field name="closing_reason" readonly="1"/>
                                <field name="closing_date" readonly="1"/>
                                <field name="termination_type" readonly="1"/>
                                <field name="if_penalty" readonly="1"/>
                                <field name="currency_id" invisible="1" />
                                <field name="penalty_amount" invisible="not if_penalty" readonly="1"/>
                                <field name="first_level_approved_by" invisible="not first_level_approved_by" readonly="1"/>
                                <field name="first_level_approval_comment" invisible="not first_level_approval_comment" readonly="1"/>
                                <field name="first_level_approved_date" invisible="not first_level_approved_date" readonly="1"/>
                                <field name="final_level_approval_comment" invisible="not final_level_approval_comment" readonly="1"/>
                                <field name="final_level_approved_by" invisible="not final_level_approved_by" readonly="1"/>
                                <field name="final_level_approved_date" invisible="not final_level_approved_date" readonly="1"/>

                                <button string="Approve &amp; Terminate" name="closure_final_approval" type="object" class="btn btn-danger" invisible="contract_type != 'closure_final_approval'"/>
                                <button string="Approve" name="closure_first_approval" type="object" class="btn btn-danger" invisible="contract_type != 'closure_pending_approval'"/>
                            </group>
                        </group>
                    </page> 
                </xpath>

                <!-- <xpath expr="//sheet/group[last()]" position="replace">
                    <group string="Payment Details">
                        <group>
                            <field name="payment_type"/>
                            <field name="amount" widget="monetary"/>
                            <field name="chq_due_date" invisible="payment_type == 'cash'"/>
                            <field name="ref"/>
                            <field name="attachment_ids"/>
                        </group>
                    </group>
                </xpath> -->

                <xpath expr="//group[3]" position="replace">
                    <group string="Property Details" invisible="is_multi_contract ">
                        <group>
                            <field name="property_id" required="not is_multi_contract" readonly="1" force_save="1"
                                options="{'no_quick_create':True,'no_create_edit':True}" />
                            <label for="property_type" class="mt-1" />
                            <div name="property_type">
                                <field name="property_type" class="oe_inline"
                                    force_save="1" /> / <field name="property_subtype_id"
                                    options="{'no_open':True}"
                                    class="oe_inline" />
                            </div>
                            <span class="o_form_label o_td_label" name="address_name">
                                <b>Address</b>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..."
                                    class="o_address_street" />
                                <field name="street2" placeholder="Street 2..."
                                    class="o_address_street" />
                                <field name="city_id" placeholder="City" class="o_address_city" />
                                <field name="state_id" class="o_address_state"
                                    placeholder="State"
                                    options="{'no_open': True, 'no_quick_create': True}" />
                                <field name="zip" placeholder="ZIP" class="o_address_zip" />
                                <field name="country_id" placeholder="Country"
                                    class="o_address_country"
                                    options="{'no_open': True, 'no_quick_create': True}" />
                            </div>
                        </group>
                        <group>
                            <field name="company_id" readonly="contract_type != 'new_contract'"/>
                            <field name="is_by_date" invsibile="1" readonly="contract_type != 'new_contract'"/>
                            <field name="currency_id" invisible="1" />
                            <field name="region_id" placeholder="Region" />
                            <field name="property_project_id" readonly="1" force_save="1"
                                invisible="not property_project_id" />
                            <field name="subproject_id" readonly="1" force_save="1"
                                invisible="not subproject_id" />
                        </group>
                    </group>
                    <group string="Property Details" invisible="not unit_ids">
                        <group>
                            <field name="property_project_id" invisible="not unit_ids" readonly="1"/>
                            <field name="unit_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                </xpath>
                <xpath expr="//div[@name='usable_area']/.." position="after">
                    <div class="col-2" invisible="property_type != 'commercial'">
                        <strong>Size</strong>
                    </div>
                    <div class="col-4" invisible="property_type != 'commercial'">
                        <field name="commercial_size" class="oe_inline"/>
                    </div>
                    <div class="col-2" invisible="property_type != 'commercial'">
                        <strong>Rate</strong>
                    </div>
                    <div class="col-4" invisible="property_type != 'commercial'">
                        <field name="commercial_rate" class="oe_inline"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="tenancy_details_tree_view_inherit" model="ir.ui.view">
            <field name="name">tenancy.details.list.view</field>
            <field name="model">tenancy.details</field>
            <field name="inherit_id" ref="rental_management.tenancy_details_list_view"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="default_order">id desc</attribute>
                    <attribute name="create">true</attribute>
                    <attribute name="import">true</attribute>
                </xpath>
                <xpath expr="//field[@name='tenancy_seq']" position="replace">
                    <field name="tenancy_seq" string="Contract No" width="110px"/>
                </xpath>
                 <xpath expr="//field[@name='total_rent']" position="replace">
                    <field name="total_rent" string="Original Price"/>
                </xpath>
                <xpath expr="//field[@name='total_rent']" position="after">
                    <field name="new_rent_monthly" string="Increased Price"
                        column_invisible="not context.get('show_increased_price', False)"/>
                </xpath>
                <xpath expr="//field[@name='tenancy_seq']" position="after">
                    <field name="days_left"></field>
                </xpath>
                <xpath expr="//field[@name='property_id']" position="after">
                    <field name="property_project_id" string="Buildings"></field>
                </xpath>
                <xpath expr="//field[@name='property_type']" position="replace">
                    <field name="property_type" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='property_subtype_id']" position="replace">
                    <field name="property_subtype_id" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='property_landlord_id']" position="replace">
                    <field name="property_landlord_id" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='total_area']" position="replace">
                    <field name="total_area" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='measure_unit']" position="replace">
                    <field name="measure_unit" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='duration_id']" position="replace">
                    <field name="duration_id" nolabel="1" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='currency_id']" position="replace">
                    <field name="currency_id" invisible="1" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='responsible_id']" position="replace">
                    <field name="responsible_id" invisible="1" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='activity_ids']" position="replace">
                    <field name="activity_ids" widget="list_activity" optional="hide"/>
                </xpath>
            </field>
        </record>
        <record id="tenancy_details_search_view_inherit" model="ir.ui.view">
            <field name="name">tenancy.details.search.view</field>
            <field name="model">tenancy.details</field>
            <field name="inherit_id" ref="rental_management.tenancy_details_search_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tenancy_seq']" position="attributes">
                    <attribute name="string">Contract No</attribute>
                </xpath>
                <xpath expr="//filter[@name='property']" position="after">
                    <filter string="Buildings" name="group_by_project" domain="[]"
                        context="{'group_by':'property_project_id'}"/>
                    <filter name="filter_expiring_soon"
                        string="Expiring Soon"
                        domain="[('contract_type', '=', 'expiring_soon')]"
                        context="{'show_increased_price': True}"/>
                </xpath>
            </field>
        </record>
        <record id="tenancy_details_action_inherit" model="ir.actions.act_window">
            <field name="name">Contracts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tenancy.details</field>
            <field name="view_mode">list,kanban,form,search,calendar,pivot,activity</field>
            <field name="context">{}</field>
        </record>
        
        <record id="tenancy_details_action_expiring" model="ir.actions.act_window">
            <field name="name">Expiring Contracts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tenancy.details</field>
            <field name="view_mode">list,kanban,form,search,calendar,pivot,activity</field>
            <field name="domain">[('contract_type', '=', 'expiring_soon')]</field>
            <field name="context">{'search_default_filter_expiring_soon': 1}</field>
        </record>
        
        <menuitem
            id="menu_expiring_contract"
            name="Expiring Contracts"
            action="tenancy_details_action_expiring"
            parent="rental_management.main_menu_rental_management"
            sequence="-1"
            active="False" />
        <record id="tenancy_action_approve_contract" model="ir.actions.act_window">
            <field name="name">Waiting For Approval</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tenancy.details</field>
            <field name="view_mode">list,kanban,form,search,calendar,pivot,activity</field>
            <field name="domain">[('contract_type', '=', 'waiting')]</field>
        </record>

        <record id="waiting_closure_first_level_approval" model="ir.actions.act_window">
            <field name="name">Close Contract - Waiting for First Level Approval</field>
            <field name="res_model">tenancy.details</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('contract_type', '=', 'closure_pending_approval')]</field>

            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Contracts available for your approval.
                </p>
            </field>
        </record>

        <record id="waiting_closure_final_level_approval" model="ir.actions.act_window">
            <field name="name">Close Contract - Waiting for Final Level Approval</field>
            <field name="res_model">tenancy.details</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('contract_type', '=', 'closure_final_approval')]</field>

            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No Contracts available for your approval.
                </p>
            </field>
        </record>

    </data>
</odoo>