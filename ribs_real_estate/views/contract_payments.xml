        <record id="action_contract_payments" model="ir.actions.act_window">
            <field name="name">Contract Payments</field>
            <field name="res_model">contract.payments</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_by_contract_id': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create contract payments to manage payments related to tenancy contracts.
                </p>
            </field>
        </record>

        <!-- # For Leasing Team (Comments Added by Finance Team) -->
        <record id="action_contract_payments_finance_comment" model="ir.actions.act_window">
            <field name="name">Payments with Finance Comments</field>
            <field name="res_model">contract.payments</field>
            <field name="view_mode">list</field>
            <field name="views">
                [(ref('contract_payment_tree_finance_comment'), 'list')]
            </field>
            <field name="domain">
                [
                    ('finance_comment_added', '=', True),
                    ('line_payment_received', '=', 'not_received'),
                ]
            </field>
            <field name="context">{'create': False}</field>
        </record>

         <!-- # For Finance Team (Comment added by Leasing Team) -->
        <record id="action_contract_payments_leasing_comment" model="ir.actions.act_window">
            <field name="name">Payments with Leasing Comments</field>
            <field name="res_model">contract.payments</field>
            <field name="view_mode">list</field>
            <field name="views">
                [(ref('contract_payment_tree_leasing_comment'), 'list')]
            </field>
            <field name="domain">
                [
                    ('leasing_comment_added', '=', True),
                    ('line_payment_received', '=', 'not_received'),
                ]
            </field>
            <field name="context">{'create': False}</field>
        </record>

    </data>
</odoo>