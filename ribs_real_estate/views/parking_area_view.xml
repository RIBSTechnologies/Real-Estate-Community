<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="parking_allocation_form_view" model="ir.ui.view">
            <field name="name">parking.allocation.form.view</field>
            <field name="model">parking.allocation</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <group>
                                <group>
                                    <field name="project_id"/>
                                </group>
                                <group>
                                    <field name="parking_ids" widget="many2many_tags"
                                           domain="[('project_id', '=', False)]"/>
                                </group>
                            </group>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="parking_allocation_list_view" model="ir.ui.view">
            <field name="name">parking.allocation.list.view</field>
            <field name="model">parking.allocation</field>
            <field name="arch" type="xml">
                <list string="Parking Areas">
                    <field name="project_id"/>
                    <field name="parking_ids"/>
                </list>
            </field>
        </record>
        <record id="parking_allocation_action" model="ir.actions.act_window">
            <field name="name">Parking Allocation</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">parking.allocation</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>