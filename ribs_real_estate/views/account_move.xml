<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_move_form_view_inherit" model="ir.ui.view">
            <field name="name">account.move.form.view</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="after">
                    <field name="report_ref"></field>
                    <field name="invoice_id_added_to_payments" invisible="move_type not in 'in_refund'"></field>
                </xpath>
                <xpath expr="//field[@name='tax_tag_ids']" position="after">
                    <field name="report_ref" readonly="False"></field>
                </xpath>
            </field>
        </record>

        <record id="account_move_tree_view_inherit" model="ir.ui.view">
            <field name="name">account.move.tree.view.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="default_order">invoice_date desc, name desc, id desc</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_date']" position="attributes">
                    <attribute name="optional">show</attribute>
                    <attribute name="invisible">0</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>