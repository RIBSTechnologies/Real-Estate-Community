<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- 1. Main renderer: adds expand <th> in header, padding <td> in footer -->
    <t t-name="ribs_real_estate.PaymentSummaryListRenderer"
       t-inherit="web.ListRenderer"
       t-inherit-mode="primary">
        <xpath expr="//thead/tr" position="inside">
            <th class="ps-expand-header" style="width:36px;"/>
        </xpath>
        <xpath expr="//tfoot/tr" position="inside">
            <td class="w-print-0 p-print-0"/>
        </xpath>
    </t>

    <!-- 2. RecordRow: appends expand-toggle button at end of each data row -->
    <t t-name="ribs_real_estate.PaymentSummaryListRenderer.RecordRow"
       t-inherit="web.ListRenderer.RecordRow"
       t-inherit-mode="primary">
        <xpath expr="//tr[hasclass('o_data_row')]" position="inside">
            <td class="ps-expand-cell text-center"
                t-on-click="(ev) => this.onClickExpandRow(record, ev)"
                tabindex="-1">
                <button class="btn btn-sm btn-link p-0 text-decoration-none" type="button">
                    <i t-att-class="this.isRowExpanded(record)
                        ? 'fa fa-chevron-up ps-expand-icon ps-icon-open text-primary'
                        : 'fa fa-chevron-down ps-expand-icon text-muted'"/>
                </button>
            </td>
        </xpath>
    </t>

    <!-- 3. Rows: inline detail row inserted directly underneath parent record row -->
    <t t-name="ribs_real_estate.PaymentSummaryListRenderer.Rows">
        <!-- Ungrouped records -->
        <t t-if="!list.isGrouped">
            <t t-foreach="list.records" t-as="record" t-key="record.id">
                <!-- Parent record row -->
                <t t-call="{{ this.constructor.recordRowTemplate }}"/>

                <!-- Inline payment detail row (directly under parent record) -->
                <tr t-if="this.isRowExpanded(record)"
                    class="ps-detail-row"
                    t-key="'ps_' + record.id">
                    <td t-att-colspan="this.columns.length + (this.hasSelectors ? 1 : 0) + 1" class="ps-detail-cell p-0">
                        <PaymentSummaryPanel
                            loading="this.expandPanel.loading"
                            payments="this.expandPanel.payments"
                            contractName="this.expandPanel.contractName"
                            formatAmount.bind="this.formatAmount"
                            formatDate.bind="this.formatDate"
                            paymentTypeBadgeClass.bind="this.paymentTypeBadgeClass"
                            paymentTypeLabel.bind="this.paymentTypeLabel"
                            statusBadgeClass.bind="this.statusBadgeClass"
                            statusLabel.bind="this.statusLabel"
                            onClose.bind="this.closePanel"
                            onReload.bind="this.reloadPanel"
                        />
                    </td>
                </tr>
            </t>

            <!-- Add-a-line row -->
            <tr t-if="this.displayRowCreates">
                <td t-if="this.withHandleColumn"/>
                <td t-att-colspan="this.withHandleColumn ? this.nbCols - 1 : this.nbCols"
                    class="o_field_x2many_list_row_add"
                    t-on-keydown="(ev) => this.onCellKeydown(ev, null)">
                    <t t-foreach="this.creates" t-as="create" t-key="create_index">
                        <a t-if="create.type === 'create'" href="#" role="button"
                           t-att-class="create_index !== 0 ? 'ml16' : ''"
                           t-att-tabindex="this.editedRecord ? '-1' : '0'"
                           t-on-click.stop.prevent="() => this.add({ context: create.context })">
                            <t t-out="create.string"/>
                        </a>
                    </t>
                </td>
            </tr>
            <!-- Empty filler rows -->
            <t t-if="!this.props.list.isGrouped and !this.props.noContentHelp">
                <tr t-foreach="this.getEmptyRowIds" t-as="emptyRowId" t-key="emptyRowId">
                    <td t-att-colspan="this.nbCols">&#8203;</td>
                </tr>
            </t>
        </t>

        <!-- Grouped records -->
        <t t-else="">
            <t t-foreach="list.groups" t-as="group" t-key="group.id">
                <t t-call="{{ this.constructor.groupRowTemplate }}"/>
                <t t-if="!group.isFolded">
                    <t t-call="{{ this.constructor.rowsTemplate }}" list="group.list"/>
                    <tr t-if="!group.list.isGrouped and this.props.editable and this.canCreate">
                        <td t-if="this.hasSelectors"/>
                        <td t-att-colspan="this.hasSelectors ? this.nbCols - 1 : this.nbCols"
                            class="o_group_field_row_add">
                            <a href="#" role="button"
                               t-on-click.stop.prevent="() => this.addInGroup(group)"
                               t-on-keydown="(ev) => this.onCellKeydown(ev)">
                                Add a line
                            </a>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </t>

</templates>
