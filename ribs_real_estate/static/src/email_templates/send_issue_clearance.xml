<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="send_issue_clearance_template" model="mail.template">
            <field name="name">Issue Clearance Notification</field>
            <field name="model_id" ref="model_tenancy_details"/>
            <field name="subject">Clearance Certificate</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333;">
                        <p>Dear <t t-out="object.tenancy_id.name or 'Tenant'"/>,</p>

                        <p>
                            We are pleased to inform you that your rental contract 
                            <strong><t t-out="object.tenancy_seq or ''"/></strong> 
                            for the property 
                            <strong><t t-call="ribs_real_estate.property_display_value"/></strong> 
                            has been successfully closed.
                        </p>

                        <p>
                            Please find attached your official <strong>Issue Clearance Certificate</strong>.
                        </p>

                        <p>
                            If you have any questions or require further assistance, please don’t hesitate to reach out to us.
                        </p>

                        <p>Thank you,<br/></p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
