<odoo>
    <data>
        <record id="mail_template_rent_approval" model="mail.template">
            <field name="name">Rent Reduction Approval Request</field>
            <field name="model_id" ref="model_tenancy_details"/>
            <field name="subject">Approval Required: Rent Value Updated</field>
            <field name="body_html">
                <![CDATA[
                    <p>Hi,</p>

                    <p>User <b><t t-out="object.env.user.name"/></b> has reduced the total rent Amount from
                    <b><t t-out="ctx.get('old_value')"/></b> to <b><t t-out="object.total_rent_year"/></b>.
                    </p>

                    <p>Approval is required to proceed.</p>

                    <p>Buildings: <b><t t-out="object.property_project_id.name"/></b></p>
                    <p>Property: <b><t t-call="ribs_real_estate.property_display_value"/></b></p>
                    <p>Contract: <b><t t-out="object.display_name" /></b></p>
                    <a t-att-href="ctx.get('record_url')">Click here to approve</a>
                    <p>Thank you,<br/></p>
                ]]>
            </field>

        </record>

    </data>
</odoo>