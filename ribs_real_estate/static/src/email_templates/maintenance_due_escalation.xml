<odoo>
    <data noupdate="1">
       <record id="maintenance_overdue_email_template" model="mail.template">
            <field name="name">Maintenance Request Overdue Notification</field>
            <field name="model_id" ref="maintenance.model_maintenance_request"/>
            <field name="subject"> Maintenance Request {{object.name}} is Overdue!</field>
            <field name="body_html">
                <![CDATA[
                    <p>Hello Manager,</p>
                    <p>
                        The maintenance request <strong><t t-out="object.name"/></strong>
                        has exceeded its time based on its priority.
                        <div style="background-color:#F3F5F6;color:#515166;font-family:Arial,Helvetica,sans-serif;font-size:14px;padding-top:5px;padding-left:30px;padding-bottom:5px;padding-right:30px;">
                        <p>
                            <a t-attf-href="#{object.get_request_url()}">View Maintenance Request Details</a>
                        </p>
                    </div>
                    </p>
<!--                    <p><b>Priority:</b> <t t-out="object.priority"/></p>-->
                    <p>
                        <b>Created On:</b>
                        <t t-out="object.create_date.strftime('%d-%m-%Y') if object.create_date else ''"/>
                        at
                        <t t-out="object.create_date.strftime('%I:%M %p') if object.create_date else ''"/>
                    </p>
                    <p>
                        <b>Due On:</b>
                        <t t-out="object.create_date.strftime('%d-%m-%Y') if object.create_date else ''"/>
                        at
                        <t t-out="object.create_date.strftime('%I:%M %p') if object.create_date else ''"/>
                    </p>
                    <p><b>Exceeded Time:</b> <t t-out="object.exceeded_time"/></p>

                    <p>Please take necessary action.</p>
                    <p>Thank you,<br/></p>
                ]]>

            </field>
        </record>
    </data>
</odoo>