<odoo>
    <data noupdate="1">
         <record id="email_template_welcome_pack" model="mail.template">
            <field name="name">Tenancy Welcome Pack Email</field>
            <field name="model_id" ref="model_tenancy_details"/>
            <field name="subject">Welcome Pack for {{ object.tenancy_seq }}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, sans-serif; line-height: 1.6;">
                        <p>Dear <strong><t t-out="object.tenancy_id.name"/></strong>,</p>
                        <p>Welcome to <strong><t t-out="object.tenancy_seq"/></strong>! We are excited to have you with us.</p>
                        <p>Please find attached your Tenancy Welcome Pack containing all the necessary documents.</p>
                        <p>If you have any questions or need assistance, feel free to reach out to us at <t t-out="object.env.company.email"/>.</p>
                        <p>Thank you,<br/></p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>