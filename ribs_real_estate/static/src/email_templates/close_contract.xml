<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="contract_closing_notification_template" model="mail.template">
            <field name="name">Contract Closing Notification</field>
            <field name="model_id" ref="model_tenancy_details"/>
            <field name="subject">Contract Closure</field>

            <field name="body_html">
                <![CDATA[
                    <div style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333;">
                        <p>Dear <t t-out="object.tenancy_id.name or 'Tenant'"/>,</p>

                        <p>
                            We would like to inform you that your rental contract
                            <strong><t t-out="object.tenancy_seq or ''"/></strong>
                            for the property
                            <strong><t t-call="ribs_real_estate.property_display_value"/></strong>
                            has been officially closed.
                        </p>

                        <!-- If penalty exists -->
                        <t t-if="ctx.get('has_penalty')">
                            <p>
                                Please note that a penalty invoice has been generated as part of the contract closure process:
                            </p>

                            <ul style="margin-left: 20px;">
                                <li><strong>Invoice Number:</strong> <t t-out="ctx['invoice_name'] or ''"/></li>
                                <li><strong>Amount:</strong> <t t-out="ctx['invoice_amount'] or ''"/></li>
                                <li><strong>Description:</strong> <t t-out="ctx['description'] or ''"/></li>
                            </ul>

                            <p>
                                You can view and download your invoice. Please contact us for any clarifications.
                            </p>
                        </t>

                        <!-- If no penalty -->
                        <t t-if="not ctx.get('has_penalty')">
                            <p>
                                No penalty has been applied as part of the contract closure.  
                                If you require any assistance, please feel free to contact us.
                            </p>
                        </t>

                        <p>Thank you,<br/></p>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>
