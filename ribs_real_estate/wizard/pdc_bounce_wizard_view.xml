<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bounce_charge_wizard" model="ir.ui.view">
        <field name="name">bounce.charge.wizard.form</field>
        <field name="model">pdc.bounce.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="penalty_confirmation"/>
                        </group>
                        <group>
                            <field name="penalty_amount" invisible="not penalty_confirmation"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" string="Mark it as Bounced" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Close" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="pdc_bounce_wizard_action" model="ir.actions.act_window">
            <field name="name">Bounce Wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pdc.bounce.wizard</field>
            <field name="view_mode">form</field>
        </record>
</odoo>
