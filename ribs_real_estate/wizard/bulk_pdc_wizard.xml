<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bulk_pdc_wizard_form" model="ir.ui.view">
            <field name="name">bulk.pdc.upload.form</field>
            <field name="model">bulk.pdc.upload</field>
            <field name="arch" type="xml">
                <form string="Bulk PDC Upload">
                    <sheet>
                        <group col="2" colspan="2">
                            <group>
                                <field name="tenancy_id" readonly="1"/>
                                <field name="journal_id"/>
                            </group>
                            <group>
                                <field name="invoice_id" readonly="1"/>
                                <field name="invoice_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="PDC Details" string="PDC Upload">
                                <field name="pdc_lines" nolabel="1" force_save="1">
                                    <list editable="bottom">
                                        <!-- <field name="inv_id"/> -->
                                        <field name="amount" required="1"/>
                                        <field name="due_date" required="1"/>
                                        <field name="cheque_ref"/>
                                        <field name="attachment_ids" widget="many2many_binary"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button string="Upload" type="object" name="create_bulk_pdc" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
