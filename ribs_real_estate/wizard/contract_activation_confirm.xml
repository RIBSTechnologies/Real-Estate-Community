<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_contract_activation_confirm_form" model="ir.ui.view">
            <field name="name">contract.activation.confirm.form</field>
            <field name="model">contract.activation.confirm</field>
            <field name="arch" type="xml">
                <form string="Confirmation">
                    <sheet>
                        <group>
                            <field name="message" nolabel="1" readonly="1"/>
                        </group>

                        <footer>
                            <button name="action_confirm"
                                    type="object"
                                    string="Yes, Continue"
                                    class="btn-primary"/>

                            <button name="action_cancel"
                                    string="Cancel"
                                    special="cancel"
                                    class="btn-secondary"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>