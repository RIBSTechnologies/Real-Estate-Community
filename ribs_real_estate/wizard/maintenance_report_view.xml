<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="maintenance_report_form_view" model="ir.ui.view">
            <field name="name">maintenance.report.form.view</field>
            <field name="model">maintenance.report</field>
            <field name="arch" type="xml">
                <form string="Maintenace Report">
                    <sheet>
                        <group>
                            <field name="maintenance_report_for"/>
                            <field name="buildings" invisible="maintenance_report_for != 'buildings'" widget="many2many_tags"/>
                            <field name="units" invisible="maintenance_report_for != 'units'" widget="many2many_tags"/>
                            <field name="contracts" invisible="maintenance_report_for != 'contracts'" widget="many2many_tags"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Print PDF" type="object"
                                class="btn btn-outline-primary"
                                name="maintenance_report_print_action"/>
                        <button string="Cancel" special="cancel" class="btn btn-outline-danger"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="maintenance_report_action" model="ir.actions.act_window">
            <field name="name">Maintenance Report</field>
            <field name="res_model">maintenance.report</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="maintenance_report_form_view"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>