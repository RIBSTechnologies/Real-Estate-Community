<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_contract_renew_confirm_wizard_form" model="ir.ui.view">
            <field name="name">contract.renew.confirm.wizard.form</field>
            <field name="model">contract.renew.confirm.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirm Contract Renewal">
                    <group>
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>

                    <footer>
                        <button name="action_confirm"
                                string="Proceed"
                                type="object"
                                class="btn-primary"/>

                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>