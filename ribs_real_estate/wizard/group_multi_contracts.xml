<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="group_multi_contracts_form_view" model="ir.ui.view">
        <field name="name">group.multi.contracts.form.view</field>
        <field name="model">group.multi.contracts</field>
        <field name="arch" type="xml">

            <form string="Contract Documents">

                <sheet>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1>
                            Multi Contract
                        </h1>
                    </div>

                    <!-- Main Information -->
                    <group string="General Information">
                        <group>

                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>

                            <field name="customer_id" required="1" options="{'no_quick_create':True}"/>
                            <field name="customer_phone" widget="phone"/>
                            <field name="customer_email" widget="email"/>

                            <field name="property_id" required="1"/>
                            <field name="unit_ids" widget="many2many_tags" required="1"/>

                        </group>

                        <group>
                            <!-- <field name="rent_unit" class="oe_inline" required="1" readonly="duration_type == 'by_date'" force_save="1"/> -->
                            <field name="total_rent_year" force_save="1"/>
                            <field name="contract_value" readonly="1" force_save="1"/>
                            <field name="is_any_deposit" force_save="1"/>
                            <field name="deposit_amount"
                                invisible="not is_any_deposit" required="is_any_deposit" force_save="1"/>
                        </group>
                    </group>

                    <!-- Contract Details -->
                    <group string="Contract Details">
                        <group>
                            <field name="duration_type" widget="radio" options="{'horizontal':True}"
                                   required="1" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="is_by_date"/>
                            <label for="grace_period_value" string="Grace Time"/>
                            <div class="o_row">
                                <field name="grace_period_value" nolabel="1"/>
                                <field name="grace_period_unit" nolabel="1"/>
                            </div>
                            <field name="grace_period_start_date"/>
                            <field name="grace_period_end_date"/>
                            <field name="start_date" required="1"/>
                            <label for="payment_term"/>
                            <div>
                                <field name="payment_term" required="1"
                                       force_save="1"/>
                                <div class="font-italic text-muted"
                                     invisible="payment_term != 'quarterly'">
                                    * 3 Month Quarter
                                </div>
                                <div class="font-italic text-muted"
                                     invisible="not available_payment_term">
                                    <field name="available_payment_term"/>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="end_date" required="1"
                                   readonly="not is_by_date" force_save="1"/>
                            <field name="days" required="1"
                                   invisible="not is_by_date" force_save="1"/>
                            <field name="duration_end_date" required="duration_type == 'by_date'"
                                   string="End Date" invisible="duration_type != 'by_date'"/>
                            <field name="total_days" invisible="duration_type != 'by_date'"/>
                            <field name="duration_ids" invisible="1"/>
                            <field name="duration" readonly="1" invisible="not is_by_date" force_save="1"/>
                            <field name="duration_id" required="duration_type == 'by_duration'"
                                   invisible="duration_type != 'by_duration' or is_by_date"
                                   options="{'no_create':True,'no_create_edit':True,'no_open':True}"/>
                        </group>
                    </group>

                    <group string="New Contract Update" invisible = "last_update_id == False">
                        <group>
                            <field name="update_increase_or_decrease"/>
                            <field name="update_amount_or_percentage"/>
                            <field name="update_amount" invisible="update_amount_or_percentage == 'percentage'"/>
                            <field name="update_percentage" invisible="update_amount_or_percentage == 'amount'"/>
                        </group>

                        <group>
                            <field name="update_from_date"/>
                            <field name="update_to_date"/>
                        </group>

                        <group>
                            <field name="update_new_rent_monthly"/>
                            <field name="update_new_rent_annually"/>
                        </group>
                    </group>
                    <!-- Contract Period Notification -->
                    <div class="alert alert-warning text-center mb-0" role="alert"
                         invisible="not is_contract_available or not contract_desc">
                        <span class="fw-bold">Selected contract period is available.</span>
                        <br/>
                        <span invisible="not contract_desc">with following draft contract</span>
                        <field name="contract_desc" invisible="not contract_desc" readonly="1"
                               force_save="1"/>
                    </div>
                    <div class="alert alert-success text-center mb-0" role="alert"
                         invisible="not is_contract_available or contract_desc">
                        Selected contract time period is available.
                    </div>
                    <div class="alert alert-danger text-center" role="alert"
                         invisible="is_contract_available or not start_date or not end_date">
                        Selected contract time period is not available.
                    </div>

                    <group>
                        <group>
                            <field name="deposit_item_id" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <group string="Taxes">
                        <group>
                            <field name="instalment_tax" readonly="1" invisible="not tax_ids" force_save="1"/>
                            <!-- <field name="deposit_tax"/>
                            <field name="service_tax"/> -->
                        </group>

                        <group>
                            <field name="tax_ids"
                                   widget="many2many_tags"
                                   required="instalment_tax or deposit_tax or service_tax"
                                   readonly="1"
                                   force_save="1"/>
                        </group>
                    </group>

                    <!-- Extra Services -->
                    <group string="Extra Services">
                        <group>
                            <field name="is_added_services" string="Extra Service ?"/>
                            <field name="added_service_invoice" invisible="not is_added_services"
                                   widget="radio" string="Invoice" readonly="1"/>
                        </group>
                        <group invisible="not is_added_services">
                            <field name="added_service_ids" nolabel="1" colspan="2">
                                <list editable="bottom">
                                    <field name="service_id" required="1"
                                           options="{'no_quick_create':True}"/>
                                    <field name="price"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </group>
                    </group>

                    <!-- Terms -->
                    <group string="Terms &amp; Conditions">
                        <field name="term_condition" widget="html"/>
                    </group>
                    <notebook>
                        <page string="Unit Pricing">

                            <group>
                                <group>
                                    <field name="overall_total" readonly="1"/>
                                    <field name="overall_discount" readonly="1"/>
                                </group>

                                <group>
                                    <field name="discount_type"/>
                                    <field name="discount_value"/>
                                </group>
                            </group>

                            <field name="unit_line_ids" nolabel="1">
                                <list editable="bottom" create="0" delete="0">

                                    <field name="selected"/>
                                    <field name="property_id" readonly="1" force_save="1"/>
                                    <field name="total_rent_year" sum="Total Rent Year" readonly="1" force_save="1"/>
                                    <field name="deposit_amount" column_invisible="1" sum="Deposit Amount" readonly="1" force_save="1"/>
                                    <field name="tax_id" readonly="1" force_save="1"/>
                                    <field name="discount_applied" readonly="1" force_save="1"/>
                                    <!-- <field name="discount_type" readonly="1"/>
                                    <field name="discount_value" readonly="1"/> -->
                                    <field name="discount_amount" readonly="1" sum="Discount Amount" force_save="1"/>
                                    <field name="amount_based_on_duration" readonly="1" sum="Discount Amount" force_save="1"/>
                                    <field name="before_vat" readonly="1" sum="Discount Amount" force_save="1"/>
                                    <field name="tax_amount" readonly="1" sum="Tax Amount" force_save="1"/>
                                    <field name="total" readonly="1" sum="Total" force_save="1"/>

                                </list>
                            </field>
                            <div class="mt-3 mb-3">
                                <button name="action_select_all"
                                        type="object"
                                        string="Select All"
                                        class="btn-secondary"/>

                                <button name="action_unselect_all"
                                        type="object"
                                        string="Clear All"
                                        class="btn-secondary ms-2"/>

                                <button name="action_apply_discount"
                                        type="object"
                                        string="Apply Discount"
                                        class="btn-primary ms-2"
                                        invisible="not unit_line_ids"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Create Contract" type="object"
                            class="btn btn-outline-success"
                            name="contract_action"
                            invisible="payment_term == 'full_payment' or not is_contract_available or not unit_ids"/>
                    <button string="Cancel" special="cancel" class="btn btn-outline-danger"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="group_multi_contracts_action_" model="ir.actions.act_window">
        <field name="name">Multi Contracts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">group.multi.contracts</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="group_multi_contracts_form_view"/>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the Multi Contracts.
            </p>
        </field>
    </record>

</odoo>