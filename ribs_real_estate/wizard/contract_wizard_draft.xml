<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Banner + Clear Draft button on the Contract Wizard -->
        <record id="contract_wizard_view_form_draft" model="ir.ui.view">
            <field name="name">contract.wizard.form.draft</field>
            <field name="model">contract.wizard</field>
            <field name="inherit_id" ref="rental_management.contract_wizard_form_view"/>
            <field name="priority">99</field>
            <field name="arch" type="xml">

                <xpath expr="//form/group[1]" position="before">
                    <field name="ribs_draft_id" invisible="1"/>
                    <field name="ribs_draft_restored" invisible="1"/>
                    <div class="alert alert-info d-flex align-items-center"
                         role="alert"
                         invisible="not ribs_draft_restored">
                        <i class="oi me-2" data-icon="history"/>
                        <span class="flex-grow-1">
                            Your previously entered details have been restored.
                            Everything you type here is saved automatically, so you
                            can close this window and continue later.
                        </span>
                        <button name="action_clear_draft"
                                type="object"
                                string="Start Fresh"
                                class="btn btn-sm btn-outline-secondary ms-2"
                                confirm="This will permanently delete the saved draft and open an empty contract form. Continue?"/>
                    </div>
                </xpath>

                <xpath expr="//footer" position="inside">
                    <button name="action_clear_draft"
                            type="object"
                            string="Discard Draft"
                            class="btn btn-outline-secondary"
                            invisible="not ribs_draft_restored"
                            confirm="This will permanently delete the saved draft. Continue?"/>
                </xpath>

            </field>
        </record>

        <!-- Draft browser (admin / troubleshooting) -->
        <record id="contract_draft_view_list" model="ir.ui.view">
            <field name="name">contract.draft.list</field>
            <field name="model">contract.draft</field>
            <field name="arch" type="xml">
                <list string="Saved Contract Drafts" create="false">
                    <field name="property_id"/>
                    <field name="contract_id" optional="hide"/>
                    <field name="user_id"/>
                    <field name="write_date" string="Last Saved"/>
                    <field name="state"/>
                    <button name="action_open_wizard"
                            type="object"
                            string="Resume"
                            icon="play_arrow"
                            invisible="state != 'draft'"/>
                </list>
            </field>
        </record>

        <record id="contract_draft_view_form" model="ir.ui.view">
            <field name="name">contract.draft.form</field>
            <field name="model">contract.draft</field>
            <field name="arch" type="xml">
                <form string="Saved Contract Draft" create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="property_id"/>
                                <field name="contract_id"/>
                            </group>
                            <group>
                                <field name="user_id"/>
                                <field name="state"/>
                                <field name="write_date" string="Last Saved"/>
                            </group>
                        </group>
                        <group string="Raw Snapshot">
                            <field name="payload" nolabel="1" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="contract_draft_action" model="ir.actions.act_window">
            <field name="name">Saved Contract Drafts</field>
            <field name="res_model">contract.draft</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'create': False}</field>
        </record>

    </data>
</odoo>
