                                    <th style="padding:6px; text-align:right;"><b>Amount</b></th>
                                    <th style="padding:6px;"><b>Date</b></th>
                                    <th style="padding:6px;"><b>Remitter Bank</b></th>
                                    <th style="padding:6px;"><b>Ref</b></th>
                                </tr>

                                <t t-foreach="bank_payments" t-as="line">
                                    <tr>
                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="dict(line._fields['payment_type'].selection).get(line.payment_type)"/>
                                        </td>

                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="line.journal_id.name"/>
                                        </td>

                                        <td style="padding:6px; text-align:right; border:1px solid #145326;">
                                            <span t-field="line.amount" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                        </td>

                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="line.chq_due_date.strftime('%d/%m/%Y') if line.chq_due_date else ''"/>
                                        </td>

                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="line.remitter_bank_id.name or line.remitter_bank or ''"/>
                                        </td>

                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="line.ref or ''"/>
                                        </td>

                                    </tr>
                                </t>
                            </table>
                        </t>
