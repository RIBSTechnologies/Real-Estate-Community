                                    <th style="padding:6px;"><b>Cheque Ref</b></th>
                                    <th style="padding:6px;"><b>Date</b></th>
                                    <th style="padding:6px;"><b>Invoice Reference</b></th>
                                    <th style="padding:6px;"><b>Journal</b></th>
                                    <th style="padding:6px;"><b>Deposit To</b></th>
                                    <th style="padding:6px;"><b>CUC Account</b></th>
                                    <th style="padding:6px; text-align:right;"><b>Amount</b></th>
                                    <th style="padding:6px;"><b>Status</b></th>
                                </tr>
                                <t t-foreach="bank_payments" t-as="line">
