<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tenancy_pdc_details_qweb_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 16px; color: #000; line-height: 1.5;">
                        <div style="text-align:center; font-weight:bold; font-size:20px; text-decoration:underline; margin-bottom:10px;">
                            Receipt Voucher
                        </div>
                        <div style="text-align:center; font-size:16px; margin-bottom:10px;">
                            <b>TRN:</b>
                        <!--<span t-out="o.trn"/>-->
                        </div>

                        <!-- Row 1: Date / RV No -->
                        <div style="width:100%; overflow:auto; margin-bottom:8px;">
                            <span style="float:left;">
                                <b>Date:</b>
                                <span t-out="datetime.date.today().strftime('%d-%m-%y')"/>
                            </span>

                            <span style="float:right;">
                                <b>RV. No.:</b>
                                <!-- <span t-out="o.rv_no"/> -->
                            </span>
                        </div>

                        <!-- Row 2: Received from / Amount -->
                        <div style="width:100%; overflow:auto; margin-bottom:8px;">
                            <span style="float:left;">
                                <b>Received From:</b>
                                <span t-out="o.tenancy_id.name"/>
                            </span>

                            <span style="float:right;">
                                <b>Amount:</b>
                                <span t-out="o.total_contract_value" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                            </span>
                        </div>

                        <!-- Other details (no extra spacing above) -->
                        <div style="font-size:16px; clear:both;">

                            <div style="margin-bottom:8px;">
                                <b>Building Account:</b>
                                <span t-out="o.property_project_id.invoice_creation_id.name or ''"/>
                            </div>

                            <div style="margin-bottom:8px;">
                                <b>Dirhams:</b>
                                <b><span t-out="'** '+o.currency_id.amount_to_text(o.total_contract_value).replace(o.currency_id.name, '').strip() + ' Only **'"/></b>
                            </div>
                            <div style="margin-bottom:15px;">
                                <b>Being:</b>
                                <span t-out="'Rent - Ejari - Sec.Dep. Flat ' + (o.property_id.name or '') + ' Con ' + (o.tenancy_seq or '') + ' From ' + ((o.start_date and o.start_date.strftime('%d-%m-%Y')) or '') + '-' + ((o.end_date and o.end_date.strftime('%d-%m-%Y')) or '')"/>
                            </div>

                        </div>

                        <!-- <t t-set="all_matched_payments" t-value="o.rent_invoice_ids.mapped('rent_invoice_id.matched_payment_ids')"/> -->
                        <t t-set="all_matched_payments" t-value="o.contract_payment_ids"/>
                        <t t-set="all_pdc_payments" t-value="o.rent_invoice_ids.mapped('rent_invoice_id.pdc_payment_ids')"/>

                        <t t-set="cash_payments" t-value="all_matched_payments.filtered(lambda p: p.journal_id and p.journal_id.type == 'cash')"/>
                        <t t-if="cash_payments">
                            <table style="width:100%; border:1px solid #145326; border-radius:6px; border-collapse:collapse; margin-bottom:30px;">
                                <tr style="font-weight:bold;">
                                    <td colspan="6" style="padding:6px 10px;">CASH PAYMENT DETAILS</td>
                                </tr>

                                <tr style="background-color:#f2f6fa; font-weight:bold; border:1px solid #145326;">
                                    <th style="padding:6px;"><b>Type</b></th>
                                    <th style="padding:6px;"><b>Beneficiary Bank</b></th>
                                    <th style="padding:6px; text-align:right;"><b>Amount</b></th>
                                    <th style="padding:6px;"><b>Date</b></th>
                                    <th style="padding:6px;"><b>Remitter Bank</b></th>
                                    <th style="padding:6px;"><b>Ref</b></th>
                                </tr>

                                <t t-foreach="cash_payments" t-as="line">
                                    <tr>

                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="dict(line._fields['payment_type'].selection).get(line.payment_type)"/>
                                        </td>

                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="line.journal_id.name"/>
                                        </td>

                                        <td style="padding:6px; text-align:right; border:1px solid #145326;">
                                            <span t-field="line.amount" t-options='{"widget":"monetary","display_currency":o.currency_id}'/>
                                        </td>

                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="line.chq_due_date.strftime('%d/%m/%Y') if line.chq_due_date else ''"/>
                                        </td>

                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="line.remitter_bank_id.name or line.remitter_bank or ''"/>
                                        </td>

                                        <td style="padding:6px; border:1px solid #145326;">
                                            <span t-out="line.ref or ''"/>
                                        </td>

                                    </tr>
                                </t>
                            </table>
                        </t>


                        <!-- ===================================================== -->
                        <!-- =============== BANK PAYMENT TABLE ================= -->
                        <!-- ===================================================== -->
                        <t t-set="bank_payments" t-value="all_matched_payments.filtered(lambda p: p.payment_type == 'bank')"/>
                        <t t-if="bank_payments">
                            <table style="width:100%; border:1px solid #145326; border-radius:6px; border-collapse:collapse; margin-bottom:30px;">
                                <tr style="font-weight:bold;">
