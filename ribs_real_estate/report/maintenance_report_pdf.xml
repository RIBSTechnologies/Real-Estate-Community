<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="maintenance_report_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                 <div style="font-family: Arial, sans-serif; font-size: 14px; color: #000; padding: 20px;">
                    <div style="text-align: center; margin-bottom: 30px;">
                        <h1 style="font-size: 24px; font-weight: bold; margin-bottom: 10px;">Maintenance Report</h1>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; border: 2px solid #333; margin-bottom: 20px;">
                        <tr style="background-color:#f2f6fa; font-weight:bold; border:1px solid #145326;">
                            <th style="padding:6px;"><b>Maintenance Request</b></th>
                            <th style="padding:6px;"><b>Total Amount</b></th>
                        </tr>

                        <t t-if="group_by and grouped_data">
                            <t t-foreach="grouped_data" t-as="group">
                                <tr style="background-color:#e8f4f8; font-weight:bold;">
                                    <td colspan="2" style="padding:8px; border:1px solid #145326;">
                                        <span t-out="group[0]"/>
                                    </td>
                                </tr>
                                <t t-foreach="group[1]" t-as="item">
                                    <t t-if="item['total'] > 0">
                                        <tr>
                                            <td style="padding:6px; border:1px solid #145326; padding-left:20px;">
                                                <span t-out="item['name']"/>
                                            </td>
                                            <td style="padding:6px; border:1px solid #145326; text-align:right;">
                                                <span t-out="'%.1f' % item['total']"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                             <tr style="background-color:#f2f6fa; font-weight:bold; border:2px solid #145326;">
                                <td style="padding:8px; border:1px solid #145326; text-align:right;">
                                    <b>Grand Total</b>
                                </td>
                                <td style="padding:8px; border:1px solid #145326; text-align:right;">
                                    <b t-out="'%.1f' % grand_total"/>
                                </td>
                            </tr>
                        </t>

                        <t t-else="">
                            <t t-foreach="docs" t-as="maintenance">
                                <tr>
                                    <td style="padding:6px; border:1px solid #145326;">
                                        <span t-out="maintenance.name"/>
                                    </td>
                                    <td style="padding:6px; border:1px solid #145326; text-align:right;">
                                        <span t-out="'%.1f' % maintenance.total"/>
                                    </td>
                                </tr>
                            </t>
                            <tr style="background-color:#f2f6fa; font-weight:bold; border:2px solid #145326;">
                                <td style="padding:8px; border:1px solid #145326; text-align:right;">
                                    <b>Grand Total</b>
                                </td>
                                <td style="padding:8px; border:1px solid #145326; text-align:right;">
                                    <b t-out="'%.1f' % grand_total"/>
                                </td>
                            </tr>
                        </t>
                    </table>
                 </div>
            </t>
        </t>
    </template>
    <record id="maintenance_report_pdf_action" model="ir.actions.report">
        <field name="name">Maintenance Report</field>
        <field name="model">maintenance.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ribs_real_estate.maintenance_report_pdf</field>
        <field name="print_report_name">'Maintenance Report'</field>
    </record>
    <record id="maintenance_report_pdf_action" model="ir.actions.report">
        <field name="name">Maintenance Report</field>
        <field name="model">maintenance.request</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">ribs_real_estate.maintenance_report_pdf</field>
        <field name="print_report_name">'Maintenance Report'</field>
    </record>
</odoo>
