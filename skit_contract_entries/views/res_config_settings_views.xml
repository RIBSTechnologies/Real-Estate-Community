<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- inherit res config settings -->
	<record id="contract_res_config_settings_import_view_form" model="ir.ui.view">
		<field name="name">contract res.config.settings.view.form.inherit</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="account.res_config_settings_view_form" />
		<field name="arch" type="xml">
			<xpath
				expr="//block[@id='accounting_reports']"
				position="after">
				<t groups="account.group_account_user">
				<block title="Contract" name="contract">
                     <setting
                                     help="When enabled, system will create accounting entry">
                        <field name="contract_posting" />
                        <div class="content-group mt-2" invisible="not contract_posting">
                            <div class="row">
                              	<label string="Accrued Revenue Account"
									for="accrued_revenue_account_id" class="col-lg-3 o_light_label" />
								<field name="accrued_revenue_account_id" required="contract_posting"/>
							</div>
							<div class="row">
								<label string="Contract Expense Account"
									for="contract_expense_account_id" class="col-lg-3 o_light_label" />
								<field name="contract_expense_account_id" required="contract_posting"/>
                            </div>
                        </div>
                    </setting>
                    <!-- add new field to update start and end date -->
                    <setting help="Automatically set the invoice start and end dates based on the contract period during invoice generation">
                        <field name="auto_apply_contract_period" />
                    </setting>
  				</block>
				</t>
			</xpath>
		</field>
	</record>
</odoo>
